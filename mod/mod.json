{
  "id": "cp-climate",
  "name": "CarPlay Ultra-Lite",
  "version": "1.3.3-ev6.7",
  "hmgapi": ">=1.1.0-rc.1",
  "authors": [
    "cp-climate contributors"
  ],
  "license": "GPL-3.0-or-later",
  "description": "EV6 USA 260507: learns Kia's confirmed fresh-air command for recirculation OFF, adds unit-aware Charging information and real vehicle notifications. Unknown states and unverified units remain unavailable. Retains native Climate controls, EV6 feedback guards and optional parked AirPlay video. Audio resume remains removed. New functions require on-car validation. Based on CarPlay Ultra-Lite and LIVI (GPL-3.0).",
  "requires": [
    "wireless-carplay-aa"
  ],
  "system": [
    {
      "model": [
        "CVEV"
      ],
      "region": "USA",
      "firmware": "260507"
    }
  ],
  "hooks": {
    "jar": "hooks.jar",
    "entry": "ioniq6.cpclimate.CpClimate",
    "points": {
      "dipo.carplay.session_started": "observe",
      "dipo.carplay.session_finalized": "observe",
      "dipo.carplay.iap_message": "observe",
      "dipo.carplay.native_iap_send": "change",
      "framework.hkmc_loader.automotive_service": "observe",
      "framework.window_manager_service.intercept_key": "replace",
      "dipo.carplay.decode_failure": "observe",
      "dipo.carplay.force_key_frame": "observe",
      "dipo.carplay.screen_timeout": "observe"
    },
    "native": {
      "libCarPlayCore.so": [
        "recipes/carplay-climate-m1.recipe"
      ]
    }
  },
  "network": {
    "rules": [
      {
        "chain": "input",
        "in": "hotspot",
        "proto": "tcp",
        "ports": [
          "7130-7135"
        ],
        "action": "accept"
      },
      {
        "chain": "input",
        "in": "hotspot",
        "proto": "tcp",
        "ports": [
          "7138-7139"
        ],
        "action": "accept",
        "when": "settings.video_playback",
        "comment": "encrypted video side streams, acknowledged and discarded"
      },
      {
        "chain": "output",
        "out": "hotspot",
        "proto": "tcp",
        "state": [
          "new",
          "established"
        ],
        "action": "accept",
        "when": "settings.video_playback",
        "comment": "phone video proxy, only while optional video is enabled"
      },
      {
        "chain": "input",
        "in": "hotspot",
        "proto": "tcp",
        "state": [
          "established",
          "related"
        ],
        "action": "accept",
        "when": "settings.video_playback",
        "comment": "phone proxy replies"
      }
    ]
  },
  "services": [
    {
      "name": "helper",
      "script": "svc/helper.sh",
      "user": "root",
      "start": "android",
      "restart": true
    }
  ],
  "usb": [
    "CarPlayUltraLite-Logs"
  ]
}
