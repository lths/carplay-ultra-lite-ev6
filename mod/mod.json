{
  "id": "cp-climate",
  "name": "CarPlay Ultra-Lite",
  "version": "1.3.3-ev6.4",
  "hmgapi": ">=1.1.0-rc.1",
  "authors": [
    "cp-climate contributors"
  ],
  "license": "GPL-3.0-or-later",
  "description": "Experimental 2024 EV6 USA 260507 update: bounded route field/size logging without payload text, OPACK parser reason/offset/tag diagnostics, video-event foreground and app-launch context, and quieter Vehicle-page command logging. Retains ev6.3 last-CarPlay-audio resume and the working climate, comfort, volume and vehicle readings. Requires working wireless CarPlay and HMG-API 1.1.0-rc.1 or later; Ultra themes need the theme-enabled routing dependency. Audio resume and visual freeze behavior still need on-car validation. Based on CarPlay Ultra-Lite and LIVI (GPL-3.0).",
  "requires": [
    "wireless-carplay-aa"
  ],
  "system": [
    {
      "model": [
        "CVEV"
      ],
      "region": "USA",
      "firmware": "260507"
    }
  ],
  "hooks": {
    "jar": "hooks.jar",
    "entry": "ioniq6.cpclimate.CpClimate",
    "points": {
      "dipo.carplay.session_started": "observe",
      "dipo.carplay.session_finalized": "observe",
      "dipo.carplay.iap_message": "observe",
      "dipo.carplay.native_iap_send": "change",
      "framework.hkmc_loader.automotive_service": "observe",
      "framework.window_manager_service.intercept_key": "replace",
      "dipo.carplay.decode_failure": "observe",
      "dipo.carplay.force_key_frame": "observe",
      "dipo.carplay.screen_timeout": "observe"
    },
    "native": {
      "libCarPlayCore.so": [
        "recipes/carplay-climate-m1.recipe"
      ]
    }
  },
  "network": {
    "rules": [
      {
        "chain": "input",
        "in": "hotspot",
        "proto": "tcp",
        "ports": [
          "7130-7135"
        ],
        "action": "accept"
      }
    ]
  },
  "services": [
    {
      "name": "helper",
      "script": "svc/helper.sh",
      "user": "root",
      "start": "android",
      "restart": true
    }
  ],
  "usb": [
    "CarPlayUltraLite-Logs"
  ]
}
